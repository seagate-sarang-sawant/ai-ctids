# AI-CTIDS Environment Configuration

# Application
APP_NAME=ai-ctids
APP_VERSION=1.0.0
DEBUG=False

# Model Configuration
MODEL_NAME=xgboost
MODEL_VERSION=latest
MODELS_DIR=./models
DATA_DIR=./data

# Training
RANDOM_SEED=42
TRAIN_SPLIT=0.7
VAL_SPLIT=0.15
TEST_SPLIT=0.15

# Weights & Biases
WANDB_PROJECT=ai-ctids
WANDB_ENTITY=your-entity
WANDB_API_KEY=your-api-key-here

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=False

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INPUT_TOPIC=network-flows
KAFKA_OUTPUT_TOPIC=threat-predictions
KAFKA_CONSUMER_GROUP=ai-ctids-consumer
KAFKA_AUTO_OFFSET_RESET=earliest

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
METRICS_ENABLED=True

# Drift Detection
DRIFT_WINDOW_SIZE=10000
DRIFT_PSI_THRESHOLD=0.2
DRIFT_CHECK_INTERVAL_SECONDS=300

# Performance
BATCH_SIZE=32
MAX_BATCH_SIZE=1000
INFERENCE_TIMEOUT_SECONDS=30.0

# Docker/Deployment
DOCKER_USERNAME=your-docker-username
DOCKER_PASSWORD=your-docker-password
